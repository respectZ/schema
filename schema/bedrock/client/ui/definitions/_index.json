{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"namespace": {
			"type": "string"
		}
	},
	"additionalProperties": {
		"if": {
			"type": "object",
			"required": ["anim_type"],
			"properties": {
				"anim_type": {
					"type": "string",
					"enum": [
						"alpha",
						"clip",
						"color",
						"flip_book",
						"aseprite_flip_book",
						"offset",
						"size",
						"uv",
						"wait"
					]
				}
			}
		},
		"then": {
			"$ref": "../animations/_index.json"
		},
		"else": {
			"$ref": "./control.json"
		}
	}
}
