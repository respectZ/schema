{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sound_name": {
			"type": "string"
		},
		"sound_volume": {
			"$ref": "../values/scalar.json#/$defs/number"
		},
		"sound_pitch": {
			"$ref": "../values/scalar.json#/$defs/number"
		},
		"sounds": {
			"anyOf": [
				{
					"type": "array",
					"items": {
						"$ref": "../structures/sound.json"
					}
				},
				{
					"$ref": "../values/scalar.json#/$defs/runtime"
				}
			]
		}
	}
}
