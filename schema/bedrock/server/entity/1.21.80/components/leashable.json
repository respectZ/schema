{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"anyOf": [
		{
			"type": "object",
			"properties": {
				"can_be_cut": {
					"$ref": "../../legacy/components/leashable.json#/anyOf/0/properties/can_be_cut"
				},
				"can_be_stolen": {
					"$ref": "../../legacy/components/leashable.json#/anyOf/0/properties/can_be_stolen"
				},
				"on_leash": {
					"$ref": "../../legacy/components/leashable.json#/anyOf/0/properties/on_leash"
				},
				"on_unleash": {
					"$ref": "../../legacy/components/leashable.json#/anyOf/0/properties/on_unleash"
				},
				"on_unleash_interact_only": {
					"type": "boolean",
					"default": false,
					"description": "When set to true, \"on_unleash\" does not trigger when the entity gets unleashed for reasons other than the player directly interacting with it."
				},
				"presets": {
					"$ref": "../../legacy/components/leashable.json#/$defs/preset_array",
					"default": []
				},
				"unleash_on_removal": {
					"$ref": "../../legacy/components/leashable.json#/anyOf/0/properties/unleash_on_removal"
				}
			},
			"additionalProperties": false
		},
		{
			"type": "null"
		}
	],
	"description": "Allows this entity to be leashed and defines the conditions and events for this entity when is leashed."
}
