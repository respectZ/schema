{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"block_distance": {
			"type": "number",
			"minimum": -3.4028234663852886e38,
			"maximum": 3.4028234663852886e38,
			"description": "Defines the distance from the mob, in blocks, that the block to move to will be chosen."
		},
		"control_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"anyOf": [
					{
						"enum": ["move", "look", "jump"],
						"description": ""
					},
					{
						"pattern": "^(?:[Mm][Oo][Vv][Ee]|[Ll][Oo][Oo][Kk]|[Jj][Uu][Mm][Pp])$(?![\\s\\S])",
						"description": ""
					}
				],
				"description": ""
			},
			"description": ""
		},
		"priority": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647,
			"description": ""
		},
		"speed_multiplier": {
			"type": "number",
			"minimum": -3.4028234663852886e38,
			"maximum": 3.4028234663852886e38,
			"description": ""
		},
		"within_radius": {
			"type": "number",
			"minimum": -3.4028234663852886e38,
			"maximum": 3.4028234663852886e38,
			"description": "Defines the distance in blocks the mob has to be from the block for the movement to be finished."
		}
	},
	"description": "Allows mob to move towards a random block."
}
