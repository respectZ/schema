{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"control_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"anyOf": [
					{
						"enum": ["move", "look", "jump"],
						"description": ""
					},
					{
						"pattern": "^(?:[Mm][Oo][Vv][Ee]|[Ll][Oo][Oo][Kk]|[Jj][Uu][Mm][Pp])$(?![\\s\\S])",
						"description": ""
					}
				],
				"description": ""
			},
			"description": ""
		},
		"poi_type": {
			"type": "string",
			"anyOf": [
				{
					"enum": ["bed", "meeting_area", "jobsite"]
				},
				{
					"pattern": "^(?:[Bb][Ee][Dd]|[Mm][Ee][Ee][Tt][Ii][Nn][Gg]_[Aa][Rr][Ee][Aa]|[Jj][Oo][Bb][Ss][Ii][Tt][Ee])$(?![\\s\\S])"
				}
			],
			"description": "Tells the goal what POI type it should be looking for"
		},
		"priority": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647,
			"description": ""
		},
		"speed_multiplier": {
			"type": "number",
			"minimum": 0,
			"maximum": 3.4028234663852886e38,
			"description": "Movement speed multiplier of the mob when using this AI Goal"
		}
	},
	"description": "Allows the mob to move to a POI if able to"
}
