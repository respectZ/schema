{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Angry",
	"description": "Defines the entity's 'angry' state using a timer.",
	"additionalProperties": false,
	"properties": {
		"angry_sound": {
			"$ref": "../../../../../vanilla/server/level_sound.json",
			"description": "The sound event to play when the mob is angry"
		},
		"broadcast_anger": {
			"type": "boolean",
			"default": false,
			"description": "Whether anger is broadcast to other entities of the same type."
		},
		"broadcastAnger": {
			"doNotSuggest": true,
			"$ref": "#/properties/broadcast_anger"
		},
		"broadcast_anger_on_attack": {
			"type": "boolean",
			"default": false
		},
		"broadcast_anger_on_being_attacked": {
			"type": "boolean",
			"default": false
		},
		"broadcast_anger_when_dying": {
			"type": "boolean",
			"default": true
		},
		"broadcast_range": {
			"type": "number",
			"default": 20,
			"description": "The range in blocks within which the broadcast is heard."
		},
		"broadcastRange": {
			"doNotSuggest": true,
			"$ref": "#/properties/broadcast_range"
		},
		"broadcast_filters": {
			"$ref": "../../../../../vanilla/server/filter/entity/_index.json"
		},
		"broadcastFilters": {
			"doNotSuggest": true,
			"$ref": "#/properties/broadcast_filters"
		},
		"broadcast_targets": {
			"type": "array",
			"items": {
				"$ref": "../../../../../vanilla/server/type_family.json"
			}
		},
		"broadcastTargets": {
			"doNotSuggest": true,
			"$ref": "#/properties/broadcast_targets"
		},
		"calm_event": {
			"type": "string",
			"description": "The event to run when the entity stops being angry."
		},
		"calmEvent": {
			"doNotSuggest": true,
			"$ref": "#/properties/calm_event"
		},
		"duration": {
			"type": "integer",
			"default": 25,
			"description": "The duration in seconds the entity will stay angry."
		},
		"duration_delta": {
			"type": "integer",
			"default": 0,
			"description": "Random variance (in seconds) added to the duration."
		},
		"durationDelta": {
			"doNotSuggest": true,
			"$ref": "#/properties/duration_delta"
		},
		"filters": {
			"$ref": "../../../../../vanilla/server/filter/entity/_index.json"
		},
		"sound_interval": {
			"type": "object",
			"additionalProperties": false,
			"description": "The range of time in seconds to randomly wait before playing the sound again",
			"properties": {
				"range_min": {
					"type": "number",
					"default": 0
				},
				"range_max": {
					"type": "number",
					"default": 0
				}
			}
		}
	}
}
