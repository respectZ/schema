{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Luck",
	"description": "Specifies how much luck the entity has.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"min": {
			"type": "integer"
		},
		"max": {
			"type": "integer"
		},
		"value": {
			"oneOf": [
				{
					"type": "integer"
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"range_min": {
							"type": "integer"
						},
						"range_max": {
							"type": "integer"
						}
					}
				}
			]
		}
	}
}
