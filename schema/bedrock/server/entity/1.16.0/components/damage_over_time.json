{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Damage Over Time",
	"description": "Applies defined amount of damage to the entity at specified intervals",
	"additionalProperties": false,
	"properties": {
		"damage_per_hurt": {
			"type": "integer",
			"default": 1,
			"description": "Amount of damage caused each hurt."
		},
		"damagePerHurt": {
			"doNotSuggest": true,
			"$ref": "#/properties/damage_per_hurt"
		},
		"time_between_hurt": {
			"type": "integer",
			"default": 0,
			"description": "Time in seconds between damage."
		},
		"timeBetweenHurt": {
			"doNotSuggest": true,
			"$ref": "#/properties/time_between_hurt"
		}
	}
}
