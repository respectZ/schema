{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Friction Modifier",
	"description": "Defines how much does friction affect this entity.",
	"additionalProperties": false,
	"properties": {
		"min": {
			"type": "integer"
		},
		"max": {
			"type": "integer"
		},
		"value": {
			"description": "The higher the number, the more the friction affects this entity. 1.0 means regular friction, 2.0 means twice as much.",
			"oneOf": [
				{
					"$ref": "#/$defs/value"
				},
				{
					"type": "number",
					"default": 1.0
				}
			]
		}
	},
	"$defs": {
		"value": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"range_max": {
					"type": "number"
				},
				"range_min": {
					"type": "number"
				}
			}
		}
	}
}
