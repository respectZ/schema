{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Absorption",
	"description": "Specifies how much absorption health the entity has.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"min": {
			"type": "number"
		},
		"max": {
			"type": "number"
		},
		"value": {
			"oneOf": [
				{
					"type": "number"
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"range_min": {
							"type": "number"
						},
						"range_max": {
							"type": "number"
						}
					}
				}
			]
		}
	}
}
