{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"control_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"enum": ["move", "look", "jump"],
				"description": ""
			},
			"description": ""
		},
		"entity_types": {
			"anyOf": [
				{
					"$ref": "../general.json#/$defs/entity_types"
				},
				{
					"type": "array",
					"items": {
						"$ref": "../general.json#/$defs/entity_types"
					}
				}
			],
			"description": "List of entity types that this entity can target if the potential target is hurt by this mob's owner"
		},
		"priority": {
			"type": "integer",
			"description": ""
		}
	},
	"description": "Allows the mob to target a mob that is hurt by their owner."
}
