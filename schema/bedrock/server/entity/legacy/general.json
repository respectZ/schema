{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"trigger": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"event": {
					"type": "string",
					"description": "The name of the event to run when this trigger fires."
				},
				"target": {
					"type": "string",
					"oneOf": [
						{
							"const": "self",
							"description": "The entity or object calling the test."
						},
						{
							"const": "block",
							"description": "The block involved with the interaction."
						},
						{
							"const": "damager",
							"description": "The damaging actor involved with the interaction."
						},
						{
							"const": "other",
							"description": "The other member of an interaction, not the caller."
						},
						{
							"const": "parent",
							"description": "The caller's current parent."
						},
						{
							"const": "player",
							"description": "The player involved with the interaction."
						},
						{
							"const": "target",
							"description": "The caller's current target."
						}
					],
					"description": "The subject of the trigger. Defaults to 'self'."
				},
				"filters": {
					"$ref": "../../../../vanilla/server/filter/entity/_index.json",
					"description": "Optional. The filter conditions that must be met for the event to fire."
				}
			}
		},
		"attribute_range": {
			"anyOf": [
				{
					"type": "number",
					"description": ""
				},
				{
					"type": "array",
					"items": {
						"type": "number",
						"description": ""
					},
					"minItems": 2,
					"maxItems": 2,
					"description": ""
				},
				{
					"type": "object",
					"properties": {
						"range_max": {
							"type": "number",
							"default": 0,
							"description": ""
						},
						"range_min": {
							"type": "number",
							"default": 0,
							"description": ""
						}
					},
					"additionalProperties": false,
					"description": ""
				}
			],
			"description": ""
		},
		"vector3": {
			"$comment": "TODO: Replace all to ref this.",
			"anyOf": [
				{
					"type": "array",
					"items": {
						"type": "number"
					},
					"maxItems": 3
				},
				{
					"type": "object",
					"properties": {
						"x": {
							"type": "number",
							"description": ""
						},
						"y": {
							"type": "number",
							"description": ""
						},
						"z": {
							"type": "number",
							"description": ""
						}
					},
					"additionalProperties": false
				}
			]
		},
		"item_obj": {
			"anyOf": [
				{
					"$ref": "../../../../vanilla/server/item_descriptor.json"
				},
				{
					"type": "object",
					"properties": {
						"item": {
							"$ref": "../../../../vanilla/server/identifiers.json#/$defs/item_identifier",
							"description": ""
						}
					},
					"required": ["item"],
					"additionalProperties": false
				}
			]
		},
		"number_or_range": {
			"anyOf": [
				{
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38
				},
				{
					"type": "array",
					"items": {
						"type": "number",
						"minimum": -3.4028234663852886e38,
						"maximum": 3.4028234663852886e38
					},
					"minItems": 2,
					"maxItems": 2
				},
				{
					"type": "object",
					"properties": {
						"range_max": {
							"type": "number",
							"minimum": -3.4028234663852886e38,
							"maximum": 3.4028234663852886e38,
							"description": ""
						},
						"range_min": {
							"type": "number",
							"minimum": -3.4028234663852886e38,
							"maximum": 3.4028234663852886e38,
							"description": ""
						}
					},
					"required": ["range_min", "range_max"],
					"additionalProperties": false
				}
			]
		},
		"entity_types": {
			"type": "object",
			"properties": {
				"max_dist": {
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38,
					"description": "Maximum distance this mob can be away to be a valid choice"
				},
				"max_height": {
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38,
					"description": "Maximum height this mob can be away to be a valid choice"
				},
				"max_flee": {
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38,
					"description": "Maximum distance this mob can be from the target to stop fleeing"
				},
				"walk_speed_multiplier": {
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38,
					"description": "Multiplier for the walking speed. A value of 1.0 means the speed is unchanged"
				},
				"sprint_speed_multiplier": {
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38,
					"description": "Multiplier for the walking speed. A value of 1.0 means the speed is unchanged"
				},
				"priority": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647,
					"description": "The amount of time in seconds that the mob has to wait before selecting a target of the same type again"
				},
				"cooldown": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647,
					"description": "The amount of time in seconds that the mob has to wait before selecting a target of the same type again"
				},
				"must_see_forget_duration": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647,
					"description": "Determines the amount of time in seconds that this mob will look for a target before forgetting about it and looking for a new one when the target isn't visible any more"
				},
				"check_if_outnumbered": {
					"type": "boolean",
					"description": "If true, the mob will check if its outnumbered"
				},
				"reevaluate_description": {
					"type": "boolean",
					"description": "If true, the mob will stop being targeted if it stops meeting any conditions."
				},
				"must_see": {
					"type": "boolean",
					"description": "If true, the mob has to be visible to be a valid choice"
				},
				"filters": {
					"$ref": "../../../../vanilla/server/filter/entity/_index.json",
					"description": "Conditions that make this entry in the list valid"
				}
			},
			"additionalProperties": false
		}
	}
}
