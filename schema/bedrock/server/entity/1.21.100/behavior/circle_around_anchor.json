{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"angle_change": {
			"type": "number",
			"default": 15
		},
		"control_flags": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string",
				"enum": ["jump", "look", "move"]
			}
		},
		"goal_radius": {
			"type": "number",
			"default": 0.5,
			"description": "Distance in blocks at which the entity is considered to have reached the goal."
		},
		"height_above_target_range": {
			"$ref": "../../1.16.0/float_range.json",
			"description": "Height above the target to maintain."
		},
		"height_adjustment_chance": {
			"type": "number",
			"default": 0.0028570001013576984
		},
		"height_offset_range": {
			"$ref": "../../1.16.0/float_range.json",
			"description": "Random vertical offset applied to the entity."
		},
		"priority": {
			"type": "integer",
			"default": 0,
			"description": "As priority approaches 0, the priority is increased. The higher the priority, the sooner this behavior will be executed as a goal."
		},
		"radius_adjustment_chance": {
			"type": "number",
			"default": 0.004000000189989805
		},
		"radius_change": {
			"type": "number",
			"default": 1
		},
		"radius_range": {
			"$ref": "../../1.16.0/float_range.json",
			"description": "Random circle radius."
		},
		"speed_multiplier": {
			"type": "number",
			"default": 1,
			"description": "Movement speed multiplier while circling."
		}
	}
}
