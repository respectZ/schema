{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"affected_by_griefing_rule": {
			"type": "boolean",
			"description": "If true, whether the goal is affected by the mob griefing game rule."
		},
		"can_place": {
			"$ref": "../../../../../vanilla/server/filter/entity/_index.json",
			"description": "Filters for if the entity should try to place its block. Self and Target are set."
		},
		"chance": {
			"type": "number",
			"minimum": -3.4028234663852886e38,
			"maximum": 3.4028234663852886e38,
			"description": "Chance each tick for the entity to try and place a block."
		},
		"control_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"enum": ["jump", "look", "move"],
				"description": ""
			},
			"default": [],
			"description": ""
		},
		"on_place": {
			"$ref": "../../legacy/general.json#/$defs/trigger",
			"description": "Trigger ran if the entity does place its block. Self, Target, and Block are set."
		},
		"placeable_carried_blocks": {
			"type": "array",
			"items": {
				"$ref": "../../../../../vanilla/server/block_descriptor.json"
			},
			"default": [],
			"description": "Block descriptors for which blocks are valid to be placed from the entity's carried item, if empty all blocks are valid."
		},
		"priority": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647,
			"default": 0,
			"description": ""
		},
		"randomly_placeable_blocks": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"block": {
						"$ref": "../../../../../vanilla/server/block_descriptor.json",
						"description": ""
					},
					"filter": {
						"$ref": "../../../../../vanilla/server/filter/entity/_index.json",
						"description": ""
					},
					"weight": {
						"type": "integer",
						"minimum": -2147483648,
						"maximum": 2147483647,
						"description": ""
					}
				},
				"additionalProperties": false
			},
			"default": [],
			"description": "Weighted block descriptors for which blocks should be randomly placed, if empty the entity will try to place its carried block from placeable_carried_blocks."
		},
		"xz_range": {
			"$ref": "#/$defs/range",
			"description": "XZ range from which the entity will try and place blocks in."
		},
		"y_range": {
			"$ref": "#/$defs/range",
			"description": "Y range from which the entity will try and place blocks in."
		}
	},
	"$defs": {
		"range": {
			"anyOf": [
				{
					"type": "number",
					"exclusiveMinimum": -2147483648,
					"exclusiveMaximum": 2147483648
				},
				{
					"type": "boolean"
				},
				{
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "number",
								"exclusiveMinimum": -2147483648,
								"exclusiveMaximum": 2147483648
							},
							{
								"type": "boolean"
							}
						]
					},
					"minItems": 2,
					"maxItems": 2
				},
				{
					"type": "object",
					"properties": {
						"range_min": {
							"anyOf": [
								{
									"type": "number",
									"exclusiveMinimum": -2147483648,
									"exclusiveMaximum": 2147483648
								},
								{
									"type": "boolean"
								}
							]
						},
						"range_max": {
							"anyOf": [
								{
									"type": "number",
									"exclusiveMinimum": -2147483648,
									"exclusiveMaximum": 2147483648
								},
								{
									"type": "boolean"
								}
							]
						}
					},
					"additionalProperties": false
				}
			]
		}
	},
	"additionalProperties": false,
	"description": "Allows the entity to place a block."
}
