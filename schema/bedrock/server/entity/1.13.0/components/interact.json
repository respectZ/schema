{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"anyOf": [
		{
			"$ref": "#/$defs/definition"
		},
		{
			"type": "null"
		}
	],
	"$defs": {
		"definition": {
			"type": "object",
			"properties": {
				"interactions": {
					"anyOf": [
						{
							"anyOf": [
								{
									"$ref": "#/$defs/interaction"
								},
								{
									"type": "null"
								}
							]
						},
						{
							"type": "array",
							"items": {
								"anyOf": [
									{
										"$ref": "#/$defs/interaction"
									},
									{
										"type": "null"
									}
								]
							}
						}
					],
					"default": []
				}
			},
			"additionalProperties": false,
			"description": "Defines interactions with this entity."
		},
		"interaction": {
			"type": "object",
			"properties": {
				"add_items": {
					"$ref": "../../legacy/components/interact.json#/$defs/interaction/properties/add_items"
