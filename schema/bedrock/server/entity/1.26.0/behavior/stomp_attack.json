{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"attack_once": {
			"type": "boolean",
			"default": false,
			"description": "Whether the entity attacks only once per engagement."
		},
		"attack_types": {
			"type": "string",
			"description": "Specific attack types this stomp attack is restricted to."
		},
		"can_spread_on_fire": {
			"type": "boolean",
			"default": false
		},
		"control_flags": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string",
				"enum": ["jump", "look", "move"]
			}
		},
		"cooldown_time": {
			"type": "number",
			"default": 1
		},
		"inner_boundary_time_increase": {
			"type": "number",
			"default": 0.25,
			"minimum": 0
		},
		"max_path_time": {
			"type": "number",
			"default": 0.550000011920929
		},
		"melee_fov": {
			"type": "number",
			"default": 90
		},
		"min_path_time": {
			"type": "number",
			"default": 0.20000000298023224
		},
		"no_damage_range_multiplier": {
			"type": "number",
			"default": 2
		},
		"on_attack": {
			"$ref": "../../1.16.0/triggers.json"
		},
		"on_kill": {
			"$ref": "../../1.16.0/triggers.json"
		},
		"outer_boundary_time_increase": {
			"type": "number",
			"default": 0.5,
			"minimum": 0
		},
		"path_fail_time_increase": {
			"type": "number",
			"default": 0.75,
			"minimum": 0
		},
		"path_inner_boundary": {
			"type": "number",
			"default": 16,
			"minimum": 0
		},
		"path_outer_boundary": {
			"type": "number",
			"default": 32,
			"minimum": 0
		},
		"priority": {
			"type": "integer",
			"default": 0,
			"description": "As priority approaches 0, the priority is increased. The higher the priority, the sooner this behavior will be executed as a goal."
		},
		"reach_multiplier": {
			"type": "number",
			"default": 2,
			"description": "Multiplier applied to the stomp reach distance."
		},
		"random_stop_interval": {
			"type": "integer",
			"default": 0,
			"minimum": 0,
			"description": "Maximum number of ticks the entity can chase before stopping."
		},
		"require_complete_path": {
			"type": "boolean",
			"default": false
		},
		"speed_multiplier": {
			"type": "number",
			"default": 1,
			"description": "Movement speed multiplier while chasing the target."
		},
		"stomp_range_multiplier": {
			"type": "number",
			"default": 2
		},
		"track_target": {
			"type": "boolean",
			"default": false,
			"description": "Whether the entity tracks its target when out of sight."
		},
		"x_max_rotation": {
			"type": "number",
			"default": 30
		},
		"y_max_head_rotation": {
			"type": "number",
			"default": 30,
			"minimum": 0
		}
	}
}
