{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Entity 1.20.0",
	"required": ["format_version", "minecraft:entity"],
	"additionalProperties": false,
	"properties": {
		"format_version": {
			"type": "string",
			"enum": ["1.20.0"]
		},
		"minecraft:entity": {
			"type": "object",
			"title": "Entity",
			"required": ["description", "components"],
			"additionalProperties": false,
			"properties": {
				"component_groups": {
					"type": "object",
					"title": "Component Groups",
					"additionalProperties": {
						"unevaluatedProperties": false,
						"allOf": [
							{
								"$ref": "./components/_index.json"
							},
							{
								"$ref": "./behaviors/_index.json"
							}
						],
						"type": "object"
					}
				},
				"components": {
					"unevaluatedProperties": false,
					"allOf": [
						{
							"$ref": "./components/_index.json"
						},
						{
							"$ref": "./behaviors/_index.json"
						}
					],
					"type": "object"
				},
				"description": {
					"$ref": "../1.8.0/_index.json#/properties/minecraft:entity/properties/description"
				},
				"events": {
					"$ref": "../1.8.0/_index.json#/properties/minecraft:entity/properties/events"
				}
			}
		},
		"use_beta_features": {
			"type": "boolean"
		}
	}
}
