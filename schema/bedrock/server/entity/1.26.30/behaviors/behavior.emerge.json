{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"control_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"anyOf": [
					{
						"enum": ["move", "look", "jump"],
						"description": ""
					},
					{
						"pattern": "^(?:[Mm][Oo][Vv][Ee]|[Ll][Oo][Oo][Kk]|[Jj][Uu][Mm][Pp])$(?![\\s\\S])",
						"description": ""
					}
				],
				"description": ""
			},
			"description": ""
		},
		"cooldown_time": {
			"type": "number",
			"minimum": 0,
			"maximum": 3.4028234663852886e38,
			"description": "Time in seconds the mob has to wait before using the goal again"
		},
		"duration": {
			"type": "number",
			"minimum": 0,
			"maximum": 3.4028234663852886e38,
			"description": "Goal duration in seconds"
		},
		"on_done": {
			"type": "object",
			"properties": {
				"event": {
					"type": "string",
					"default": "",
					"description": ""
				},
				"filters": {
					"$ref": "../../../../../vanilla/server/filter/entity/_index.json",
					"description": ""
				},
				"target": {
					"type": "string",
					"anyOf": [
						{
							"$ref": "../../../../../vanilla/server/filter/general.json#/$defs/filter_subject",
							"description": ""
						},
						{
							"pattern": "^(?:[sS][eE][lL][fF]|[oO][tT][hH][eE][rR]|[pP][lL][aA][yY][eE][rR]|[tT][aA][rR][gG][eE][tT]|[pP][aA][rR][eE][nN][tT]|[bB][aA][bB][yY]|[bB][lL][oO][cC][kK]|[dD][aA][mM][aA][gG][eE][rR]|[hH][oO][lL][dD][eE][rR]|[iI][tT][eE][mM])$(?![\\s\\S])",
							"description": ""
						}
					],
					"default": "self",
					"description": ""
				}
			},
			"additionalProperties": false,
			"description": "Trigger to be executed when the goal execution is about to end"
		},
		"priority": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647,
			"description": ""
		}
	},
	"description": "Allows this entity to emerge from the ground"
}
