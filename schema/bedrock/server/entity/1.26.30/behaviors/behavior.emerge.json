{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"control_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"anyOf": [
					{
						"enum": ["move", "look", "jump"],
						"description": ""
					},
					{
						"pattern": "^(?:[Mm][Oo][Vv][Ee]|[Ll][Oo][Oo][Kk]|[Jj][Uu][Mm][Pp])$(?![\\s\\S])",
						"description": ""
					}
				],
				"description": ""
			},
			"description": ""
		},
		"cooldown_time": {
			"type": "number",
			"minimum": 0,
			"maximum": 3.4028234663852886e38,
			"description": "Time in seconds the mob has to wait before using the goal again"
		},
		"duration": {
			"type": "number",
			"minimum": 0,
			"maximum": 3.4028234663852886e38,
			"description": "Goal duration in seconds"
		},
		"on_done": {
			"$ref": "../../legacy/general.json#/$defs/trigger",
			"description": "Trigger to be executed when the goal execution is about to end"
		},
		"priority": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647,
			"description": ""
		}
	},
	"description": "Allows this entity to emerge from the ground"
}
