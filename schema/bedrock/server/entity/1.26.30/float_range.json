{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"oneOf": [
		{
			"type": "number"
		},
		{
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"items": {
				"type": "number"
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"min": {
					"type": "number"
				},
				"max": {
					"type": "number"
				},
				"range_min": {
					"type": "number"
				},
				"range_max": {
					"type": "number"
				}
			}
		}
	]
}
