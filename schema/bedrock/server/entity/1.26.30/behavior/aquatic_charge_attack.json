{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"attack_reach": {
			"type": "number",
			"default": 0.05000000074505806,
			"description": "Horizontal reach grown around the mob's AABB to register a hit.",
			"minimum": 0
		},
		"charge_cooldown_time": {
			"$ref": "#/$defs/item_floatrange",
			"description": "Range of time in seconds to wait before starting another charge. Check that the limits imposed on the range (minimum, maximum and maximum distance between values) are respected",
			"anyOf": [
				{
					"type": "number",
					"minimum": 0
				},
				{
					"type": "array",
					"items": {
						"minimum": 0
					}
				},
				{
					"type": "object",
					"properties": {
						"min": {
							"minimum": 0
						},
						"max": {
							"minimum": 0
						},
						"range_min": {
							"minimum": 0
						},
						"range_max": {
							"minimum": 0
						}
					}
				}
			]
		},
		"charge_overshoot_distance": {
			"type": "number",
			"default": 1.5,
			"description": "Distance beyond the target the mob aims during a charge.",
			"minimum": 0
		},
		"charge_speed": {
			"type": "number",
			"default": 0.05999999865889549,
			"minimum": 0.05000000074505806
		},
		"charge_speed_multiplier": {
			"type": "number"
		},
		"control_flags": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string",
				"enum": ["jump", "look", "move"]
			}
		},
		"knockback_force": {
			"type": "number",
			"default": 2,
			"description": "Knockback force applied to the target on hit.",
			"minimum": 0
		},
		"max_charge_distance": {
			"type": "number",
			"default": 16,
			"description": "Maximum distance at which the mob attempts a charge.",
			"minimum": 0
		},
		"priority": {
			"type": "integer",
			"default": 0,
			"minimum": 0
		}
	},
	"$defs": {
		"item_floatrange": {
			"type": "object",
			"properties": {
				"max": {
					"type": "number",
					"default": 0
				},
				"min": {
					"type": "number",
					"default": 0
				}
			},
			"additionalProperties": false
		}
	}
}
