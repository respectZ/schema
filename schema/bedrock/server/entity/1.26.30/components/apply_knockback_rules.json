{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"$defs": {
		"preset": {
			"type": "object",
			"properties": {
				"check_if_target_is_immersed_in_water": {
					"$ref": "../../legacy/components/apply_knockback_rules.json#/$defs/preset/properties/check_if_target_is_immersed_in_water",
					"description": ""
				},
				"extra_knockback_approach": {
					"type": "string",
					"anyOf": [
						{
							"enum": ["reapply_default", "multiply_reduced"],
							"description": ""
						},
						{
							"pattern": "^(?:[rR][eE][aA][pP][pP][lL][yY]_[dD][eE][fF][aA][uU][lL][tT]|[mM][uU][lL][tT][iI][pP][lL][yY]_[rR][eE][dD][uU][cC][eE][dD])$",
							"description": ""
						}
					],
					"default": "reapply_default",
					"description": ""
				},
				"filter": {
					"$ref": "../../legacy/components/apply_knockback_rules.json#/$defs/preset/properties/filter",
					"description": ""
				},
				"horizontal_power": {
					"$ref": "../../legacy/components/apply_knockback_rules.json#/$defs/preset/properties/horizontal_power",
					"description": ""
				},
				"knockback_mode": {
					"type": "string",
					"anyOf": [
						{
							"enum": ["relative_horizontal", "hit_direction"],
							"description": ""
						},
						{
							"pattern": "^(?:[rR][eE][lL][aA][tT][iI][vV][eE]_[hH][oO][rR][iI][zZ][oO][nN][tT][aA][lL]|[hH][iI][tT]_[dD][iI][rR][eE][cC][tT][iI][oO][nN])$",
							"description": ""
						}
					],
					"default": "relative_horizontal",
					"description": ""
				},
				"scale_with_damage": {
					"type": "boolean",
					"default": false,
					"description": ""
				},
				"slowdown_scale": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"default": 0.5,
					"description": ""
				},
				"vertical_power": {
					"$ref": "../../legacy/components/apply_knockback_rules.json#/$defs/preset/properties/vertical_power",
					"description": ""
				},
				"vertical_velocity_cap": {
					"$ref": "../../legacy/components/apply_knockback_rules.json#/$defs/preset/properties/vertical_velocity_cap",
					"description": ""
				}
			},
			"additionalProperties": false,
			"description": ""
		}
	},
	"properties": {
		"presets": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/preset",
				"description": ""
			},
			"description": ""
		}
	},
	"additionalProperties": false,
	"description": ""
}
