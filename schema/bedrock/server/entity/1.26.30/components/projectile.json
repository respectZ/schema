	"$defs": {
		"impact_damage": {
			"type": "object",
			"properties": {
				"apply_knockback_to_blocking_targets": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, knockback is still applied to targets that successfully blocked the hit."
				},
				"catchFire": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, the entity hit is set on fire (uses the projectile's `on_fire_time`).",
					"doNotSuggest": true
				},
				"catch_fire": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, the entity hit is set on fire (uses the projectile's `on_fire_time`)."
				},
				"ceil_pre_critical_damage": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, rounds the projectile's damage up to the next integer before the critical-hit multiplier is applied."
				},
				"channeling": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, the projectile can call down a lightning bolt on the entity hit during a thunderstorm."
				},
				"damage": {
					"anyOf": [
						{
							"type": "number",
							"minimum": -3.4028234663852886e38,
							"maximum": 3.4028234663852886e38,
							"default": 0,
							"description": ""
						},
						{
							"type": "object",
							"properties": {
								"range_max": {
									"type": "number",
									"minimum": -3.4028234663852886e38,
									"maximum": 3.4028234663852886e38,
									"default": 0,
									"description": ""
								},
								"range_min": {
									"type": "number",
									"minimum": -3.4028234663852886e38,
									"maximum": 3.4028234663852886e38,
									"default": 0,
									"description": ""
								}
							},
							"additionalProperties": false,
							"description": ""
						},
						{
							"type": "array",
							"prefixItems": [
								{
									"type": "number",
									"minimum": -3.4028234663852886e38,
									"maximum": 3.4028234663852886e38,
									"default": 0,
									"description": ""
								},
								{
									"type": "number",
									"minimum": -3.4028234663852886e38,
									"maximum": 3.4028234663852886e38,
									"default": 0,
									"description": ""
								}
							],
							"items": false,
							"minItems": 2,
							"maxItems": 2,
							"description": ""
						},
						{
							"type": "null",
							"description": ""
						}
					],
					"description": "Range of damage to apply on impact. A random value in `[min, max]` is rolled per hit and the velocity-scaled `power_multiplier` term is added to it to define the projectile's base damage."
				},
				"destroy_on_hit": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, the projectile is removed when it deals damage to an entity."
				},
				"destroy_on_hit_requires_damage": {
					"type": "boolean",
					"default": true,
					"description": "If `true`, `destroy_on_hit` only triggers when at least one point of damage is actually dealt (targets that fully absorb damage will not destroy the projectile)."
				},
				"destroyonhit": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, the projectile is removed when it deals damage to an entity.",
					"doNotSuggest": true
				},
				"difficulty_randomization": {
					"type": "string",
					"enum": ["none", "additive", "multiplicative"],
					"default": "none",
					"description": "Controls how world difficulty contributes to the rolled damage. `none` ignores difficulty, `additive` adds a difficulty-driven term on top of the base damage, and `multiplicative` folds the difficulty term into `power_multiplier` before scaling by velocity."
				},
				"filter": {
					"type": "string",
					"default": "",
					"description": "Entity family or type that the projectile is restricted to damaging. Entities outside the filter are not damaged."
				},
				"knockback": {
					"type": "boolean",
					"default": false,
					"description": "If `true`, the entity hit is knocked back away from the projectile."
				},
				"max_critical_damage": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647,
					"default": 2147483647,
					"description": "If specified, sets the maximum damage after critical damage has been applied. Enchantments have already been applied at this point, so this clamps the final damage value of critical hits."
				},
				"maxcriticaldamage": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647,
					"default": 2147483647,
					"description": "If specified, sets the maximum damage after critical damage has been applied. Enchantments have already been applied at this point, so this clamps the final damage value of critical hits.",
					"doNotSuggest": true
				},
				"min_critical_damage": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647,
					"default": 0,
					"description": "If specified, sets the minimum damage after critical damage has been applied. Enchantments have already been applied at this point, so this clamps the final damage value of critical hits."
				},
				"mincriticaldamage": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647,
					"default": 0,
					"description": "If specified, sets the minimum damage after critical damage has been applied. Enchantments have already been applied at this point, so this clamps the final damage value of critical hits.",
					"doNotSuggest": true
				},
				"power_multiplier": {
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38,
					"default": 0,
					"description": "Multiplied by the projectile's velocity and added to the rolled `damage` to define the projectile's base damage, so it can be used on its own to scale damage by the projectile's velocity."
				},
				"powermultiplier": {
					"type": "number",
					"minimum": -3.4028234663852886e38,
					"maximum": 3.4028234663852886e38,
					"default": 0,
					"description": "Multiplied by the projectile's velocity and added to the rolled `damage` to define the projectile's base damage, so it can be used on its own to scale damage by the projectile's velocity.",
					"doNotSuggest": true
				},
				"semi_random_diff_damage": {
					"description": ""
				},
				"semirandomdiffdamage": {
					"description": "",
					"doNotSuggest": true
				},
				"set_last_hurt_requires_damage": {
					"type": "boolean",
					"default": true,
					"description": "If `true`, the projectile only registers as the last hurt-by source on the target when at least one point of damage is actually dealt."
				}
			},
			"additionalProperties": false,
			"allOf": [
				{
					"if": {
						"anyOf": [
							{
								"required": ["semirandomdiffdamage"],
								"description": ""
							},
							{
								"required": ["semi_random_diff_damage"],
								"description": ""
							}
						],
						"description": ""
					},
					"then": {
						"properties": {
							"difficulty_randomization": {
								"default": "additive",
								"description": ""
							}
						},
						"allOf": [
							{
								"if": {
									"not": {
										"anyOf": [
											{
												"required": ["power_multiplier"],
												"description": ""
											},
											{
												"required": ["powermultiplier"],
												"description": ""
											}
										],
										"description": ""
									},
									"description": ""
								},
								"then": {
									"properties": {
										"power_multiplier": {
											"default": 2,
											"description": ""
										}
									},
									"description": ""
								},
								"description": ""
							}
						],
						"description": ""
					},
					"description": ""
				}
			],
			"description": "Deals damage to the entity that was hit and optionally applies knockback, fire, channeling, and critical-hit scaling."
		},
