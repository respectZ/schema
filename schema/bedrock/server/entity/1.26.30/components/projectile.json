			"additionalProperties": false,
			"description": "Map of on-hit subcomponents that drive what happens when the projectile impacts a block, fluid, or entity. Each key is a subcomponent name and its value is that subcomponent's configuration."
		},
		"should_bounce": {
			"anyOf": [
				{
					"type": "string",
					"enum": ["no", "if_invulnerable", "if_no_damage_dealt"],
					"default": "no",
					"description": ""
				},
				{
					"type": "boolean",
					"description": ""
				}
			],
			"default": "no",
			"description": "Controls whether the projectile bounces off entities on impact. `no` disables bouncing, `if_invulnerable` bounces only off invulnerable entities, and `if_no_damage_dealt` bounces whenever no damage is dealt to the target."
		}
	},
	"description": "Turns the entity into a projectile: a thrown or shot entity that flies along a ballistic arc and reacts when it impacts a block, a fluid, or another entity."
}
