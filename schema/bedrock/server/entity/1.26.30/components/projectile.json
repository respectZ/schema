				},
				"spawn_chance": {
					"$ref": "../../legacy/components/projectile.json#/$defs/spawn_chance"
				},
				"stick_in_ground": {
					"$ref": "../../legacy/components/projectile.json#/$defs/stick_in_ground"
				},
				"teleport_owner": {
