				},
				"ignite": {
					"$ref": "../../legacy/components/projectile.json#/$defs/ignite"
				},
				"impact_damage": {
					"$ref": "#/$defs/impact_damage"
				},
				"mob_effect": {
					"$ref": "../../legacy/components/projectile.json#/$defs/mob_effect"
				},
				"particle_on_hit": {
					"$ref": "../../legacy/components/projectile.json#/$defs/particle_on_hit"
				},
				"remove_on_hit": {
					"$ref": "../../legacy/components/projectile.json#/$defs/remove_on_hit"
				},
				"spawn_aoe_cloud": {
