{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"control_flags": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string",
				"enum": ["jump", "look", "move"]
			}
		},
		"cooldown_time": {
			"type": "number",
			"default": 1
		},
		"max_distance": {
			"type": "number",
			"default": 15
		},
		"max_sneak_range": {
			"type": "number",
			"default": 15
		},
		"max_sprint_range": {
			"type": "number",
			"default": 4
		},
		"priority": {
			"type": "integer",
			"default": 0,
			"description": "As priority approaches 0, the priority is increased. The higher the priority, the sooner this behavior will be executed as a goal."
		},
		"reach_multiplier": {
			"type": "number",
			"default": 2,
			"minimum": 0
		},
		"sneak_speed_multiplier": {
			"type": "number",
			"default": 0.6000000238418579,
			"minimum": 0,
			"description": "Sneak speed multiplier while approaching the target."
		},
		"sprint_speed_multiplier": {
			"type": "number",
			"default": 1.3300000429153442,
			"description": "Sprint speed multiplier while approaching the target."
		},
		"walk_speed_multiplier": {
			"type": "number",
			"default": 0.800000011920929,
			"description": "Walk speed multiplier while approaching the target."
		},
		"x_max_rotation": {
			"type": "number",
			"default": 30
		},
		"y_max_head_rotation": {
			"type": "number",
			"default": 30,
			"minimum": 0
		}
	}
}
