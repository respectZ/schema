{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"celebration_sound": {
			"$ref": "../../../../../vanilla/server/level_sound.json",
			"description": "The sound event to trigger during the celebration."
		},
		"control_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"anyOf": [
					{
						"enum": ["move", "look", "jump"],
						"description": ""
					},
					{
						"pattern": "^(?:[Mm][Oo][Vv][Ee]|[Ll][Oo][Oo][Kk]|[Jj][Uu][Mm][Pp])$(?![\\s\\S])",
						"description": ""
					}
				],
				"description": ""
			},
			"description": ""
		},
		"duration": {
			"type": "number",
			"minimum": 0,
			"maximum": 3.4028234663852886e38,
			"description": "The duration in seconds that the celebration lasts for."
		},
		"jump_interval": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"max": {
					"type": "number",
					"minimum": 0,
					"maximum": 3.4028234663852886e38,
					"description": ""
				},
				"min": {
					"type": "number",
					"minimum": 0,
					"maximum": 3.4028234663852886e38,
					"description": ""
				}
			},
			"description": "Minimum and maximum time between jumping (positive, in seconds)."
		},
		"on_celebration_end_event": {
			"$ref": "../../legacy/general.json#/$defs/trigger",
			"description": "The event to trigger when the goal's duration expires."
		},
		"priority": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647,
			"description": ""
		},
		"sound_interval": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"max": {
					"type": "number",
					"minimum": 0,
					"maximum": 3.4028234663852886e38,
					"description": ""
				},
				"min": {
					"type": "number",
					"minimum": 0,
					"maximum": 3.4028234663852886e38,
					"description": ""
				}
			},
			"description": "Minimum and maximum time between sound events (positive, in seconds)."
		}
	},
	"description": "Allows this entity to celebrate surviving a raid by making celebration sounds and jumping."
}
