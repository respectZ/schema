{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Entity 1.8.0",
	"required": ["format_version", "minecraft:entity"],
	"additionalProperties": false,
	"properties": {
		"format_version": {
			"type": "string",
			"enum": ["1.8.0"]
		},
		"minecraft:entity": {
			"type": "object",
			"title": "Entity",
			"required": ["description", "components"],
			"additionalProperties": false,
			"properties": {
				"component_groups": {
					"type": "object",
					"title": "Component Groups",
					"additionalProperties": {
						"allOf": [
							{
								"$ref": "./components/_index.json"
							},
							{
								"$ref": "./behaviors/_index.json"
							},
							{
								"$ref": "./triggers/_index.json"
							}
						],
						"type": "object",
						"unevaluatedProperties": false
					}
				},
				"components": {
					"allOf": [
						{
							"$ref": "./components/_index.json"
						},
						{
							"$ref": "./behaviors/_index.json"
						},
						{
							"$ref": "./triggers/_index.json"
						}
					],
					"type": "object",
					"unevaluatedProperties": false
				},
				"description": {
					"$ref": "./description.json"
				},
				"events": {
					"type": "object",
					"title": "Events",
					"additionalProperties": {
						"$ref": "./event.json",
						"title": "Event Definition"
					},
					"properties": {
						"minecraft:entity_born": {
							"$ref": "./event.json"
						},
						"minecraft:entity_spawned": {
							"$ref": "./event.json"
						},
						"minecraft:on_prime": {
							"$ref": "./event.json"
						},
						"minecraft:transformed": {
							"$ref": "./event.json"
						}
					}
				}
			}
		}
	}
}
