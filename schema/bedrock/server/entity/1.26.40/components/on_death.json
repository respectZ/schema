{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"event": {
			"type": "string",
			"default": "",
			"description": "The event to run when the conditions for this trigger are met."
		},
		"filters": {
			"$ref": "../../../../../vanilla/server/filter/entity/_index.json",
			"description": "The list of conditions for this trigger to execute."
		},
		"target": {
			"type": "string",
			"anyOf": [
				{
					"$ref": "../../../../../vanilla/server/filter/general.json#/$defs/filter_subject",
					"description": "The target of the event."
				},
				{
					"pattern": "^(?:[sS][eE][lL][fF]|[oO][tT][hH][eE][rR]|[pP][lL][aA][yY][eE][rR]|[tT][aA][rR][gG][eE][tT]|[pP][aA][rR][eE][nN][tT]|[bB][aA][bB][yY]|[bB][lL][oO][cC][kK]|[dD][aA][mM][aA][gG][eE][rR]|[hH][oO][lL][dD][eE][rR]|[iI][tT][eE][mM])$",
					"description": "The target of the event."
				}
			],
			"default": "self",
			"description": "The target of the event."
		}
	},
	"additionalProperties": false,
	"description": "Adds a trigger to call on this entity's death."
}
