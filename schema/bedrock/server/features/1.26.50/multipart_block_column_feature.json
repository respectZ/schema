{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Multipart Block Column Feature",
	"additionalProperties": false,
	"required": ["format_version", "minecraft:multipart_block_column_feature"],
	"properties": {
		"format_version": {
			"type": "string"
		},
		"minecraft:multipart_block_column_feature": {
			"$ref": "#/$defs/multipart_block_column_feature"
		}
	},
	"$defs": {
		"multipart_block_column_feature": {
			"type": "object",
			"additionalProperties": false,
			"required": ["description", "tip_block", "frustum_block", "middle_block", "base_block"],
			"oneOf": [
				{
					"required": ["height_range"]
				},
				{
					"required": ["weighted_heights"]
				}
			],
			"properties": {
				"description": {
					"type": "object",
					"description": "Metadata that identifies this feature.",
					"additionalProperties": false,
					"required": ["identifier"],
					"properties": {
						"identifier": {
							"$ref": "../../../../vanilla/definition/identifier.json",
							"description": "The identifier for this feature. The identifier must include a namespace and must match the filename."
						}
					}
				},
				"tip_block": {
					"$ref": "../../../../vanilla/server/block_descriptor.json",
					"description": "The topmost block of the column."
				},
				"frustum_block": {
					"$ref": "../../../../vanilla/server/block_descriptor.json",
					"description": "The second topmost block below the tip if the column is at least two blocks"
				},
				"middle_block": {
					"$ref": "../../../../vanilla/server/block_descriptor.json",
					"description": "The block that is placed between the base and frustum blocks when the column is at least four blocks"
				},
				"base_block": {
					"$ref": "../../../../vanilla/server/block_descriptor.json",
					"description": "The bottom-most block when the column is at least three blocks"
				},
				"height_range": {
					"$ref": "../general.json#/$defs/int_range",
					"description": "The range of blocks the column can be high"
				},
				"weighted_heights": {
					"type": "array",
					"minItems": 1,
					"description": "Weighted list of heights",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["value", "weight"],
						"properties": {
							"value": {
								"type": "integer"
							},
							"weight": {
								"type": "integer",
								"minimum": 1,
								"maximum": 2147483647
							}
						}
					}
				},
				"direction": {
					"type": "string",
					"enum": ["up", "down", "north", "south", "east", "west"],
					"default": "up",
					"description": "The direction of the column. If omitted then it will default to 'UP'"
				},
				"may_place_on": {
					"type": "array",
					"items": {
						"$ref": "../../../../vanilla/server/block_descriptor.json"
					}
				},
				"may_replace": {
					"type": "array",
					"description": "A list of blocks that may be replaced during placement. Omit this field to allow any block to be replaced.",
					"items": {
						"$ref": "../../../../vanilla/server/block_descriptor.json"
					}
				}
			}
		}
	}
}
