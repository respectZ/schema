{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Block 1.26.50",
	"description": "Block definition file for behavior packs (format_version 1.26.50)",
	"additionalProperties": false,
	"required": ["format_version", "minecraft:block"],
	"properties": {
		"format_version": {
			"$ref": "../../../../vanilla/definition/format_version.json",
			"const": "1.26.50"
		},
		"minecraft:block": {
			"type": "object",
			"title": "Block",
			"description": "Root block object",
			"additionalProperties": false,
			"required": ["description"],
			"properties": {
				"description": {
					"$ref": "../1.26.40/description.json"
				},
				"components": {
					"$ref": "../1.26.20/components/_index.json"
				},
				"permutations": {
					"type": "array",
					"description": "List of permutations for the block.",
					"items": {
						"type": "object",
						"title": "Permutation",
						"additionalProperties": false,
						"properties": {
							"condition": {
								"$ref": "../../../../vanilla/definition/molang.json#/$defs/string",
								"description": "A Molang expression that evaluates to true or false to determine if this permutation should be used. For permutation conditions you are limited to using one Molang query: 'query.block_state()'."
							},
							"components": {
								"$ref": "../1.26.20/components/_index.json",
								"description": "List of all components that are used in this permutation.",
								"allOf": [
									{
										"not": {
											"required": ["minecraft:redstone_consumer"]
										}
									},
									{
										"not": {
											"required": ["minecraft:block_entity"]
										}
									}
								]
							}
						}
					}
				}
			},
			"allOf": [
				{
					"$ref": "../1.26.40/constraints.json"
				}
			]
		},
		"use_beta_features": {
			"type": "boolean"
		}
	}
}
